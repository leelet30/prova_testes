import sqlite3

def conectar():
    conn = sqlite3.connect("escola.db")
    return conn

def criar_tabela(nome_banco= "escola.db"):

    conn = sqlite3.connect(nome_banco)
    cursor = conn.cursor()

    cursor.execute("""
        CREATE TABLE IF NOT EXISTS alunos (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            nome TEXT NOT NULL,
            idade INTEGER NOT NULL,
            nota REAL)
    """)

    conn.commit()
    conn.close()

def cadastro_aluno(nome: str, idade, nota, 
                   nome_banco= "escola.db"):

    if nome.strip() == "":
        return "Nome do aluno não pode ficar em branco."
    
    elif idade > 22:
        return "Idade acima de 22 anos."
    
    else:
        conn = sqlite3.connect(nome_banco)
        cursor = conn.cursor()

        cursor.execute("INSERT INTO alunos (nome, idade, nota) VALUES (?, ?, ?)", (nome, idade, nota))  

        conn.commit()
        conn.close()

        return "Aluno cadastrado com sucesso!"

def delete_aluno(id, nome_banco= "escola.db"):
    if id > 0:
        conn = sqlite3.connect(nome_banco)
        cursor = conn.cursor()

        cursor.execute("DELETE FROM alunos WHERE id = ?", (id,))  

        conn.commit()
        conn.close()

        return True
    else:
        return False

def update_idade_aluno(id_aluno, idade):

    if idade >22:
        return "Idade acima de 22 anos."

    conn = conectar()
    cursor = conn.cursor()

    cursor.execute("UPDATE alunos SET idade = ? WHERE id = ?", (idade, id_aluno))
    rows_affected = cursor.rowcount

    if rows_affected > 0:
        conn.commit()
        conn.close()

    else:
        return f"O aluno de ID {id_aluno} não foi encontrado no banco de dados."

def getAlunos():
    conn = conectar()
    cursor = conn.cursor()

    cursor.execute("SELECT * FROM alunos")
    dados_alunos = cursor.fetchall()

    conn.close()
    return dados_alunos
