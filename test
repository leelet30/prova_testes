import unittest #essa biblioteca é para criar os testes unitários
import sqlite3 #essa biblioteca é para manipular o banco de dados
import os #essa biblioteca é para apagar o banco de dados depois do teste, para não ficar acumulando lixo
import database as db

class TestCadastroAluno(unittest.TestCase): #casos de teste para a classe TestDatabase, que herda da classe TestCase do unittest


    def setUp(self): #o setup é um método que é executado antes de cada teste, para preparar o ambiente de teste. cria a acaixa de areia
       #o self é uma referência para o objeto que está sendo criado, nesse caso, a instância da classe TestDatabase.
       self.banco_teste = "banco_teste.db" #aqui é o nome do banco de dados que será usado para os testes, para não interferir no banco de dados real.
       db.criar_tabela(nome_banco=self.banco_teste) 


    def tearDown(self):
        if os.path.exists(self.banco_teste):
            os.remove(self.banco_teste) 

    def test_cadastrar_aluno_com_sucesso(self): #nesse caso de teste, estamos testando se o cadastro de um aluno com sucesso funciona corretamente.
        db.cadastro_aluno("Toninho", 1.5, 17, 
                          self.banco_teste)

        conn = sqlite3.connect(self.banco_teste)
        cursor = conn.cursor()
        cursor.execute ("SELECT * FROM alunos WHERE nome = 'Toninho' ")
        aluno_salvo = cursor.fetchone()
        conn.close()

        self.assertIsNotNone(aluno_salvo, "O aluno não esta cadastrado") #aqui testa se o aluno foi cadastrado, se não for, retorna a mensagem "O aluno não esta cadastrado"
        self.assertEqual(aluno_salvo[1], "Toninho") #aqui testa se o nome do aluno cadastrado é igual ao que foi passado no cadastro
        self.assertEqual(aluno_salvo[2], 1.5) #aqui testa se a nota do aluno cadastrado é igual ao que foi passado no cadastro
        self.assertEqual(aluno_salvo[3], 17) #aqui testa se a idade do aluno cadastrado é igual ao que foi passado no cadastro


